{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "早点下班",
  "version": "0.2.0-alpha.1",
  "identifier": "com.zaodianxiaban.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "早点下班 · 本地工作台",
        "width": 1060,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600,
        "visible": false,
        "create": false
      },
      {
        "label": "widget",
        "title": "早点下班悬浮窗",
        "url": "index.html?window=widget",
        "width": 360,
        "height": 300,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "create": false
      },
      {
        "label": "quick_add",
        "title": "快速收集",
        "url": "index.html?window=quick_add",
        "width": 480,
        "height": 440,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "本地优先的待办、工时与隐私办公助手",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
